@model Equipment

@{
    ViewData["Title"] = "equipment Details";
}

<div class="text-center">
    <h1 class="display-4">@Model.Name</h1>
    <p>@Model.Description</p>
    <hr>
    <ul>
        <li>Daily Rate: $@Model.DailyRate</li>
        <li>Category: @Model.Category</li>
        <li>Availability: @Model.Availability</li>
    </ul>


</div>

